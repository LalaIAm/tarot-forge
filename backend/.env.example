# Database (default: SQLite in repo)
# DATABASE_URL=sqlite:///./vibe_tarot.db

# Where to store card images and exports (default: backend/uploads)
# IMAGE_STORAGE_DIR=./uploads

# OpenAI API key for DALL·E 3 image generation
# OPENAI_API_KEY=

# CORS allowed origins (comma-separated; default: http://localhost:5173)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
